#
# Estate-policy exemptions for legacy demonstration files under
# absolute-zero/ (submodule, pinned to hyperpolymath/absolute-zero) and
# aletheia/ subdirs. These pre-date the estate-wide
# ReScript→AffineScript migration; the absolute-zero/ entries mirror
# that repo's own .hypatia-ignore (kept here defensively in case
# hypatia scans through the submodule boundary). They are
# demonstration scaffolds, not load-bearing code paths.
#
# TODO 2026-Q3: migrate these to AffineScript and drop the exemptions.

cicd_rules/banned_language_file:absolute-zero/src/AuditTrail.res
cicd_rules/banned_language_file:absolute-zero/interpreters/rescript/malbolgeInterpreter.res
cicd_rules/banned_language_file:absolute-zero/examples/SafeDOMExample.res
cicd_rules/banned_language_file:aletheia/examples/SafeDOMExample.res

# Go-language demonstration of "nop" semantics in the absolute-zero
# subdirectory. Mirrors the file in the standalone absolute-zero repo's
# own .hypatia-ignore.
cicd_rules/banned_language_file:absolute-zero/examples/go/nop.go

# Java/Kotlin/Swift demonstration files in the absolute-zero examples
# tree. Same rationale as the .res/.go entries above — these are part of
# the vendored language-demo subtree, not load-bearing code. Will
# collapse to a single `absolute-zero/examples/**` file_pattern entry in
# .hypatia-baseline.json once standards#180 (file_pattern glob matching
# in in_baseline()) merges.
cicd_rules/banned_language_file:absolute-zero/examples/java/Nop.java
cicd_rules/banned_language_file:absolute-zero/examples/java/BalancedOps.java
cicd_rules/banned_language_file:absolute-zero/examples/kotlin/Nop.kt
cicd_rules/banned_language_file:absolute-zero/examples/kotlin/BalancedOps.kt
